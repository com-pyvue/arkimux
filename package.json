{
  "name": "arkimux-public-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "agent-input/code",
    "apps/packages/*",
    "apps/packages/*/*",
    "apps/hosts/*",
    "bootstrap",
    "cli",
    "core",
    "local",
    "contracts"
  ],
  "scripts": {
    "test:arkimux-cli": "vitest run --config test/cli/vitest.config.ts",
    "test:agent-input-code": "vitest run --config test/agent-input/code/vitest.config.ts",
    "test:agent-execution": "vitest run --config test/core/vitest.config.ts",
    "test:agent-execution-apps": "vitest run --config test/apps/vitest.config.ts",
    "test:provider-contract": "vitest run --config test/provider-conformance/vitest.contract.config.ts",
    "typecheck:arkimux-cli": "tsc --project cli/tsconfig.json && tsc --project test/cli/tsconfig.json",
    "typecheck:agent-input-code": "tsc --project agent-input/code/tsconfig.json && tsc --project test/agent-input/code/tsconfig.json",
    "typecheck:agent-execution": "tsc --project core/tsconfig.json",
    "typecheck:provider-conformance": "tsc --project test/provider-conformance/tsconfig.json",
    "build:agent-execution-apps": "node apps/build.mjs",
    "typecheck:agent-execution-local": "tsc --project local/tsconfig.json",
    "typecheck:agent-execution-apps": "tsc --project apps/tsconfig.json",
    "build:arkimux-cli": "node cli/build.mjs",
    "build:agent-input-code": "node agent-input/code/build.mjs",
    "build:agent-execution": "node core/build.mjs",
    "build:agent-execution-local": "node local/build.mjs",
    "mock-debugger:public:probe": "node scripts/probe-mock-debugger-public-image.mjs",
    "mock-debugger:conformance": "node --experimental-transform-types scripts/probe-mock-debugger-public-protocol.mjs --built-cli",
    "typecheck": "npm run typecheck:agent-execution && npm run typecheck:agent-input-code && npm run typecheck:agent-execution-apps && npm run typecheck:agent-execution-local && npm run typecheck:arkimux-cli && npm run typecheck:provider-conformance",
    "test": "npm run test:agent-execution && npm run test:agent-input-code && npm run test:agent-execution-apps && npm run test:arkimux-cli && npm run test:provider-contract",
    "build": "node contracts/build.mjs && npm run build:agent-execution && npm run build:agent-input-code && npm run build:agent-execution-apps && npm run build:agent-execution-local && npm run build:arkimux-cli",
    "mock-debugger:candidate:build": "node scripts/build-mock-debugger-candidate.mjs",
    "mock-debugger:candidate:probe": "node scripts/probe-mock-debugger-candidate.mjs",
    "mock-debugger:candidate:bridge": "node scripts/probe-mock-debugger-retained-bridge.mjs",
    "mock-debugger:public:publish": "node scripts/publish-mock-debugger-image.mjs",
    "start:agent-execution-api": "node apps/dist/hosts/api/local-filesystem-server.js",
    "bootstrap:agent-execution-local": "node apps/dist/hosts/api/bootstrap-local-operator.js",
    "benchmark:agent-execution-local": "node apps/dist/hosts/api/benchmark-local-run-queries.js",
    "dev:agent-execution-web": "vite --config apps/hosts/web/vite.config.ts --host localhost --port 5173"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-parser": "npm:typescript@5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.0.0",
    "@types/d3": "^7.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "hono": "^4.13.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0"
}
