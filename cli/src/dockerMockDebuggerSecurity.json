[
  "run",
  "--rm",
  "--interactive",
  "--network",
  "none",
  "--read-only",
  "--user",
  "65532:65532",
  "--cap-drop",
  "ALL",
  "--security-opt",
  "no-new-privileges=true",
  "--pids-limit",
  "64",
  "--memory",
  "256m",
  "--cpus",
  "1",
  "--tmpfs",
  "/tmp:rw,noexec,nosuid,size=16m",
  "--tmpfs",
  "/work/scratch:rw,noexec,nosuid,size=64m"
]
